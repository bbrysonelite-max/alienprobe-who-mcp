# Copy to .env, or set these in your MCP client's server config `env` block.
# NEVER commit a real key. .env is already gitignored.

# A THROWAWAY Base-mainnet wallet holding a little USDC. Optional:
# without it the server still starts and `who_terms` still works; only `who` refuses.
# The server never logs, echoes, or returns this value.
PRIVATE_KEY=0xyour64charhexprivatekey

# Hard ceiling on a single lookup, in USD. The lookup is advertised at $0.05.
MAX_USD_PER_CALL=0.10

# Hard ceiling on everything this server process spends before it is restarted.
MAX_USD_PER_SESSION=1.00
